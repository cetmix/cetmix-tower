<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cx_tower_git_github_sync_wizard_view_form" model="ir.ui.view">
        <field name="name">cx.tower.git.github.sync.wizard.form</field>
        <field name="model">cx.tower.git.github.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm GitHub owner id">
                <p>
                    The stored GitHub owner id differs from GitHub for the
                    owners below. Overwrite replaces the stored value.
                    Cancel leaves it unchanged. The repository id and
                    private flag were already updated.
                </p>
                <field name="line_ids" nolabel="1">
                    <list create="0" delete="0" edit="0">
                        <field name="owner_id" />
                        <field name="stored_github_owner_ref" />
                        <field name="fetched_github_owner_ref" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_overwrite"
                        type="object"
                        string="Overwrite"
                        class="btn-primary"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="cx_tower_git_github_sync_wizard_action" model="ir.actions.act_window">
        <field name="name">Confirm GitHub owner id</field>
        <field name="res_model">cx.tower.git.github.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
