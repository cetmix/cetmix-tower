<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="github_api_secret" model="cx.tower.key">
        <field name="name">GitHub API Secret</field>
        <field name="reference">github_api_secret</field>
        <field name="key_type">s</field>
        <field name="secret_value" />
    </record>
    <record id="github_api_secret_global_value" model="cx.tower.key.value">
        <field name="key_id" ref="github_api_secret" />
        <field name="secret_value" />
    </record>
    <record id="config_github_api_secret" model="ir.config_parameter">
        <field name="key">cetmix_tower_git_github.default_secret_id</field>
        <field name="value" eval="str(ref('github_api_secret'))" />
    </record>
</odoo>
