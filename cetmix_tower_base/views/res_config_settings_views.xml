<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.cetmix.tower.base
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <form position="inside">
                <app
                    data-string="Cetmix Tower"
                    string="Cetmix Tower"
                    name="cetmix_tower_base"
                    groups="cetmix_tower_base.group_root"
                />
            </form>
        </field>
    </record>

    <record id="action_cetmix_tower_config_settings" model="ir.actions.act_window">
        <field name="name">General Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form" />
        <field name="path">cetmix_tower_settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field
            name="context"
        >{'module' : 'cetmix_tower_base', 'bin_size': False}</field>
    </record>
</odoo>
