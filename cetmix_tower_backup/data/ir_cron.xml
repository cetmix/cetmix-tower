<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_backup_cleanup" model="ir.cron">
            <field name="name">Cetmix Tower: Backup clean-up</field>
            <field name="model_id" ref="model_cx_tower_backup" />
            <field name="state">code</field>
            <field name="code">model._run_cleanup()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
    <function model="cx.tower.plan.log" name="_reconcile_backup_operations" />
</odoo>
