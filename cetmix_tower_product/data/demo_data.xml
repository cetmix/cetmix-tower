<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Demo Tower Variables -->
    <record id="tower_var_server_size" model="cx.tower.variable">
        <field name="name">Server Size</field>
        <field name="reference">server_size</field>
        <field name="variable_type">o</field>
        <field
            name="note"
        >Configure server instance size for optimal performance</field>
    </record>

    <record id="tower_var_db_version" model="cx.tower.variable">
        <field name="name">Database Version</field>
        <field name="reference">db_version</field>
        <field name="variable_type">o</field>
        <field name="note">Select database engine and version</field>
    </record>

    <record id="tower_var_backup_frequency" model="cx.tower.variable">
        <field name="name">Backup Frequency</field>
        <field name="reference">backup_frequency</field>
        <field name="variable_type">o</field>
        <field name="note">Configure automated backup schedule</field>
    </record>

    <!-- Server Size Options -->
    <record id="server_size_micro" model="cx.tower.variable.option">
        <field name="name">Micro Instance</field>
        <field name="value_char">micro</field>
        <field name="variable_id" ref="tower_var_server_size" />
        <field name="sequence">10</field>
    </record>

    <record id="server_size_small" model="cx.tower.variable.option">
        <field name="name">Small Instance</field>
        <field name="value_char">small</field>
        <field name="variable_id" ref="tower_var_server_size" />
        <field name="sequence">20</field>
    </record>

    <record id="server_size_medium" model="cx.tower.variable.option">
        <field name="name">Medium Instance</field>
        <field name="value_char">medium</field>
        <field name="variable_id" ref="tower_var_server_size" />
        <field name="sequence">30</field>
    </record>

    <record id="server_size_large" model="cx.tower.variable.option">
        <field name="name">Large Instance</field>
        <field name="value_char">large</field>
        <field name="variable_id" ref="tower_var_server_size" />
        <field name="sequence">40</field>
    </record>

    <!-- Database Version Options -->
    <record id="db_postgresql_14" model="cx.tower.variable.option">
        <field name="name">PostgreSQL 14</field>
        <field name="value_char">postgresql-14</field>
        <field name="variable_id" ref="tower_var_db_version" />
        <field name="sequence">10</field>
    </record>

    <record id="db_postgresql_13" model="cx.tower.variable.option">
        <field name="name">PostgreSQL 13</field>
        <field name="value_char">postgresql-13</field>
        <field name="variable_id" ref="tower_var_db_version" />
        <field name="sequence">20</field>
    </record>

    <record id="db_mysql_8" model="cx.tower.variable.option">
        <field name="name">MySQL 8.0</field>
        <field name="value_char">mysql-8.0</field>
        <field name="variable_id" ref="tower_var_db_version" />
        <field name="sequence">30</field>
    </record>

    <!-- Backup Frequency Options -->
    <record id="backup_daily" model="cx.tower.variable.option">
        <field name="name">Daily Backup</field>
        <field name="value_char">daily</field>
        <field name="variable_id" ref="tower_var_backup_frequency" />
        <field name="sequence">10</field>
    </record>

    <record id="backup_weekly" model="cx.tower.variable.option">
        <field name="name">Weekly Backup</field>
        <field name="value_char">weekly</field>
        <field name="variable_id" ref="tower_var_backup_frequency" />
        <field name="sequence">20</field>
    </record>

    <record id="backup_hourly" model="cx.tower.variable.option">
        <field name="name">Hourly Backup</field>
        <field name="value_char">hourly</field>
        <field name="variable_id" ref="tower_var_backup_frequency" />
        <field name="sequence">30</field>
    </record>
</odoo>
