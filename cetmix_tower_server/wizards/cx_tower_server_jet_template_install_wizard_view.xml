<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="cx_tower_server_jet_template_install_wizard_view_form"
        model="ir.ui.view"
    >
        <field name="name">cx.tower.server.jet.template.install.wizard.view.form</field>
        <field name="model">cx.tower.server.jet.template.install.wizard</field>
        <field name="arch" type="xml">
            <form string="Install Jet Template">
                <group>
                    <field
                        name="server_ids"
                        widget="many2many_tags"
                        required="1"
                        string="Install on"
                        options="{'no_create': True}"
                        groups="cetmix_tower_server.group_manager,cetmix_tower_server.group_root"
                    />
                    <label for="jet_template_id" string="Jet Template" />
                    <div class="o_row">
                        <field
                            name="jet_template_id"
                            domain="template_domain"
                            default_focus="1"
                            options="{'no_create': True}"
                        />
                        <field name="template_domain" invisible="1" />
                        <field
                            name="tag_ids"
                            widget="many2many_tags"
                            placeholder="with tags"
                            options="{'no_create': True}"
                        />
                    </div>
                    <field
                        name="note"
                        readonly="1"
                        attrs="{'invisible': [('note', '=', False)]}"
                    />
                </group>

                <field
                    name="variable_value_ids"
                    attrs="{'invisible': [('jet_template_id', '=', False)]}"
                >
                    <tree editable="bottom">
                        <field name="variable_id" readonly="1" />
                        <field name="variable_type" invisible="1" />
                        <field
                            name="value_char"
                            attrs="{'readonly': [('variable_type', '=', 'o')]}"
                        />
                        <field
                            name="option_id"
                            options="{'no_create': True}"
                            attrs="{'readonly': [('variable_type', '=', 's')]}"
                        />
                    </tree>
                </field>

                <footer>
                    <button
                        name="action_install_template"
                        type="object"
                        string="Install"
                        class="oe_highlight"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="cx_tower_server_jet_template_install_wizard_action"
        model="ir.actions.act_window"
    >
        <field name="name">Install Jet Template</field>
        <field name="res_model">cx.tower.server.jet.template.install.wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field
            name="view_id"
            ref="cx_tower_server_jet_template_install_wizard_view_form"
        />
        <field name="context">{'default_server_ids': active_ids}</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_cx_tower_server" />
        <field name="binding_view_types">form,list</field>
    </record>
</odoo>
