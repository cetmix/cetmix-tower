<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cx_tower_environment_view_tree" model="ir.ui.view">
        <field name="name">cx.tower.environment.view.list</field>
        <field name="model">cx.tower.environment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field
                    name="reference"
                    placeholder="Can contain English letters, digits and '_'. Leave blank to autogenerate"
                />
                <field name="color" widget="color_picker" />
            </list>
        </field>
    </record>

    <record id="cx_tower_environment_search_view" model="ir.ui.view">
        <field name="name">cx.tower.environment.view.search</field>
        <field name="model">cx.tower.environment</field>
        <field name="arch" type="xml">
            <search string="Search Environments">
                <field
                    name="name"
                    string="Name/Reference"
                    filter_domain="['|', ('name', 'ilike', self), ('reference', 'ilike', self)]"
                />
            </search>
        </field>
    </record>

    <record id="action_cx_tower_environment" model="ir.actions.act_window">
        <field name="name">Environments</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cx.tower.environment</field>
        <field name="path">cetmix_tower_environments</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="cx_tower_environment_search_view" />
    </record>
</odoo>
