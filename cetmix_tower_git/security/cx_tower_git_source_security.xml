<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Legacy regime: projects with no Jets -->

    <!-- Manager Read Rule -->
    <record id="rule_git_source_manager_read" model="ir.rule">
        <field name="name">Git Source: Manager Read Access</field>
        <field name="model_id" ref="model_cx_tower_git_source" />
        <field
            name="domain_force"
        >[('git_project_id.jet_ids', '=', False), '|', ('git_project_id.user_ids', 'in', [user.id]), ('git_project_id.manager_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('cetmix_tower_base.group_manager'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <!-- Additional Manager Read Rule with Server Access -->
    <record id="rule_git_source_manager_read_server" model="ir.rule">
        <field name="name">Git Source: Manager Read Access via Server</field>
        <field name="model_id" ref="model_cx_tower_git_source" />
        <field name="domain_force">[('git_project_id.jet_ids', '=', False), '|',
            ('git_project_id.git_project_rel_ids.server_id.user_ids', 'in', [user.id]),
            ('git_project_id.git_project_rel_ids.server_id.manager_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('cetmix_tower_base.group_manager'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <!-- Manager Write/Create Rule -->
    <record id="rule_git_source_manager_write" model="ir.rule">
        <field name="name">Git Source: Manager Write/Create Access</field>
        <field name="model_id" ref="model_cx_tower_git_source" />
        <field
            name="domain_force"
        >[('git_project_id.jet_ids', '=', False), ('git_project_id.manager_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('cetmix_tower_base.group_manager'))]" />
        <field name="perm_read" eval="0" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="0" />
    </record>

    <!-- Manager Delete Rule -->
    <record id="rule_git_source_manager_unlink" model="ir.rule">
        <field name="name">Git Source: Manager Delete Access</field>
        <field name="model_id" ref="model_cx_tower_git_source" />
        <field
            name="domain_force"
        >[('git_project_id.jet_ids', '=', False), ('git_project_id.manager_ids', 'in', [user.id]), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('cetmix_tower_base.group_manager'))]" />
        <field name="perm_read" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="1" />
    </record>

    <!-- Jet-project regime -->

    <record id="cx_tower_git_source_rule_user" model="ir.rule">
        <field name="name">Git Source: User Read Access via Jet</field>
        <field name="model_id" ref="model_cx_tower_git_source" />
        <field name="domain_force">
            [('git_project_id.jet_ids', 'any', [
                ('user_ids', 'in', [user.id]),
                ('server_id.user_ids', 'in', [user.id])
            ])]
        </field>
        <field name="groups" eval="[(4, ref('cetmix_tower_base.group_user'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="cx_tower_git_source_rule_manager" model="ir.rule">
        <field name="name">Git Source: Manager Read Access via Jet</field>
        <field name="model_id" ref="model_cx_tower_git_source" />
        <field name="domain_force">
            [('git_project_id.jet_ids', 'any', [
                '&amp;',
                    '|',
                        ('user_ids', 'in', [user.id]),
                        ('manager_ids', 'in', [user.id]),
                    '|',
                        ('server_id.user_ids', 'in', [user.id]),
                        ('server_id.manager_ids', 'in', [user.id])
            ])]
        </field>
        <field name="groups" eval="[(4, ref('cetmix_tower_base.group_manager'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="cx_tower_git_source_rule_manager_write" model="ir.rule">
        <field name="name">Git Source: Manager Write Access via Jet</field>
        <field name="model_id" ref="model_cx_tower_git_source" />
        <field name="domain_force">
            [
                ('git_project_id.jet_ids', '!=', False),
                ('git_project_id.jet_ids', 'not any', [
                    '|',
                        ('manager_ids', 'not in', [user.id]),
                        '&amp;',
                            ('server_id.user_ids', 'not in', [user.id]),
                            ('server_id.manager_ids', 'not in', [user.id])
                ])
            ]
        </field>
        <field name="groups" eval="[(4, ref('cetmix_tower_base.group_manager'))]" />
        <field name="perm_read" eval="0" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <!-- Root Access Rule -->
    <record id="rule_git_source_root" model="ir.rule">
        <field name="name">Git Source: Root Full Access</field>
        <field name="model_id" ref="model_cx_tower_git_source" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('cetmix_tower_base.group_root'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>
