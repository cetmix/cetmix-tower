<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cx_tower_jet_template_view_form" model="ir.ui.view">
        <field name="name">cx.tower.jet.template.view.form.git</field>
        <field name="model">cx.tower.jet.template</field>
        <field
            name="inherit_id"
            ref="cetmix_tower_server.cx_tower_jet_template_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="git_projects" string="Git Projects">
                    <group>
                        <field name="use_git_projects" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
