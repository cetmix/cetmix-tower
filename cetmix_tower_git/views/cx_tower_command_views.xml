<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cx_tower_command_view_form" model="ir.ui.view">
        <field name="name">cx.tower.command.view.form.git</field>
        <field name="model">cx.tower.command</field>
        <field name="inherit_id" ref="cetmix_tower_server.cx_tower_command_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='path']" position="attributes">
                <attribute name="required">action == 'git_project_upload'</attribute>
            </xpath>
            <xpath expr="//field[@name='path']" position="after">
                <field
                    name="git_file_name"
                    invisible="action != 'git_project_upload'"
                    required="action == 'git_project_upload'"
                    placeholder="eg repos.yml or {{ tower.jet.reference }}.yml"
                />
            </xpath>
        </field>
    </record>
</odoo>
