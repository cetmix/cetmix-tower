<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cx_tower_jet_view_form_inherit" model="ir.ui.view">
        <field name="name">cx.tower.jet.view.form.inherit</field>
        <field name="model">cx.tower.jet</field>
        <field name="inherit_id" ref="cetmix_tower_server.cx_tower_jet_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="access_links" string="Access Links">
                    <field name="access_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="template_id" />
                            <field
                                name="url_resolved"
                                groups="cetmix_tower_server.group_manager"
                            />
                            <field name="is_url_valid" column_invisible="True" />
                            <button
                                name="action_open_url"
                                type="object"
                                icon="fa-external-link"
                                string="Open"
                                invisible="not is_url_valid"
                            />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
