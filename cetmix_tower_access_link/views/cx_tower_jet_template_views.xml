<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cx_tower_jet_template_view_form_inherit" model="ir.ui.view">
        <field name="name">cx.tower.jet.template.view.form.inherit</field>
        <field name="model">cx.tower.jet.template</field>
        <field
            name="inherit_id"
            ref="cetmix_tower_server.cx_tower_jet_template_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="access_links" string="Access Links">
                    <field
                        name="access_template_ids"
                        widget="many2many_tags"
                        placeholder="Select Link Templates..."
                    />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
