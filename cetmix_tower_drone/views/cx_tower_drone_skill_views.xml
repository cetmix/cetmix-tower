<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cx_tower_drone_skill_view_form" model="ir.ui.view">
        <field name="name">cx.tower.drone.skill.view.form</field>
        <field name="model">cx.tower.drone.skill</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" duplicate="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                        </group>
                        <group>
                            <field name="reference" readonly="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cx_tower_drone_skill_view_list" model="ir.ui.view">
        <field name="name">cx.tower.drone.skill.view.list</field>
        <field name="model">cx.tower.drone.skill</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" duplicate="0">
                <field name="name" />
                <field name="reference" optional="show" />
            </list>
        </field>
    </record>

    <record id="cx_tower_drone_skill_view_search" model="ir.ui.view">
        <field name="name">cx.tower.drone.skill.view.search</field>
        <field name="model">cx.tower.drone.skill</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="name"
                    string="Name/Reference"
                    filter_domain="['|', ('name', 'ilike', self), ('reference', 'ilike', self)]"
                />
            </search>
        </field>
    </record>

    <record id="cx_tower_drone_skill_action" model="ir.actions.act_window">
        <field name="name">Drone Skills</field>
        <field name="res_model">cx.tower.drone.skill</field>
        <field name="path">cetmix_tower_drone_skills</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
