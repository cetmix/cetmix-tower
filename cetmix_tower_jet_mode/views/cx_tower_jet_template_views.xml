<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cx_tower_jet_template_view_form_inherit_mode" model="ir.ui.view">
        <field name="name">cx.tower.jet.template.view.form.inherit.mode</field>
        <field name="model">cx.tower.jet.template</field>
        <field
            name="inherit_id"
            ref="cetmix_tower_server.cx_tower_jet_template_view_form"
        />
        <field name="arch" type="xml">
            <!-- Add mode selector after title with read-only description below -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group name="jet_mode">
                    <group>
                        <field name="mode_required" widget="boolean_toggle" />
                        <field
                            name="active_mode_id"
                            options="{'no_create': True}"
                            placeholder="Select Active Mode..."
                            required="mode_required"
                        />
                    </group>
                    <group>
                        <div colspan="2" invisible="not active_mode_id">
                            <label
                                for="active_mode_description"
                                string="Mode Description"
                                style="font-weight: bold; display: block; margin-bottom: 5px;"
                            />
                            <field
                                name="active_mode_description"
                                widget="html"
                                readonly="1"
                                nolabel="1"
                            />
                        </div>
                    </group>
                </group>
            </xpath>

            <xpath
                expr="//field[@name='variable_value_ids']/list"
                position="attributes"
            >
                <attribute name="decoration-hidden">not is_mode_allowed</attribute>
            </xpath>

            <xpath expr="//field[@name='variable_value_ids']/list" position="inside">
                <field name="is_mode_allowed" column_invisible="True" />
            </xpath>

            <xpath expr="//field[@name='action_ids']/list" position="attributes">
                <attribute name="decoration-hidden">not is_mode_allowed</attribute>
            </xpath>

            <xpath expr="//field[@name='action_ids']/list" position="inside">
                <field name="is_mode_allowed" column_invisible="True" />
            </xpath>

            <!-- Add tab to manage Jet Modes -->
            <xpath expr="//notebook" position="inside">
                <page string="Modes" name="modes">
                    <field name="mode_ids">
                        <list>
                            <field name="sequence" widget="handle" />
                            <field name="name" />
                            <field name="access_level" />
                            <field name="variable_ids" widget="many2many_tags" />
                            <field name="action_ids" widget="many2many_tags" />
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="name" placeholder="e.g. Backups" />
                                        <field name="access_level" />
                                        <field name="sequence" />
                                    </group>
                                    <group>
                                        <field
                                            name="allowed_variable_ids"
                                            invisible="1"
                                        />
                                        <field
                                            name="variable_ids"
                                            widget="many2many_tags"
                                            domain="[('id', 'in', allowed_variable_ids)]"
                                            placeholder="Configurations..."
                                        />
                                        <field
                                            name="action_ids"
                                            widget="many2many_tags"
                                            domain="[('jet_template_id', '=', parent.id)]"
                                            placeholder="Lifecycle Actions..."
                                        />
                                    </group>
                                </group>
                                <notebook>
                                    <page string="Description">
                                        <field
                                            name="description"
                                            widget="html"
                                            placeholder="Enter mode description here..."
                                        />
                                    </page>
                                </notebook>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
