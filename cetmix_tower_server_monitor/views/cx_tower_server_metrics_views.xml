<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cx_tower_server_metrics_view_tree" model="ir.ui.view">
        <field name="name">cx.tower.server.metrics.view.list</field>
        <field name="model">cx.tower.server.metrics</field>
        <field name="arch" type="xml">
            <list>
                <field name="timestamp" />
                <field name="server_id" />
                <field name="cpu_percent" widget="progressbar" />
                <field name="ram_used_mb" />
                <field name="ram_total_mb" />
                <field name="disk_used_gb" />
                <field name="disk_total_gb" />
                <field name="source" />
            </list>
        </field>
    </record>

    <record id="action_cx_tower_server_metrics" model="ir.actions.act_window">
        <field name="name">Server Metrics</field>
        <field name="res_model">cx.tower.server.metrics</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
