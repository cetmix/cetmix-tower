<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Server Kanban Inheritance -->
    <record id="cx_tower_server_view_kanban_inherit" model="ir.ui.view">
        <field name="name">cx.tower.server.view.kanban.inherit</field>
        <field name="model">cx.tower.server</field>
        <field
            name="inherit_id"
            ref="cetmix_tower_server.cx_tower_server_view_kanban"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="monitoring_mode" />
                <field name="last_metrics_id" />
                <field name="cpu_usage_pct" />
                <field name="ram_usage_pct" />
                <field name="disk_usage_pct" />
                <field name="ram_total_mb" />
                <field name="ram_used_mb" />
                <field name="disk_total_gb" />
                <field name="disk_used_gb" />
                <field name="cpu_cores" />
                <field name="monitor_push_status" />
                <field name="alert_cpu_pct" />
                <field name="alert_ram_pct" />
                <field name="alert_disk_pct" />
            </xpath>
            <xpath expr="//t[@t-name='card']//footer" position="attributes">
                <attribute
                    name="class"
                    add="flex-column align-items-start"
                    separator=" "
                />
            </xpath>
            <xpath expr="//t[@t-name='card']//footer" position="inside">
                <div
                    t-if="record.monitoring_mode.raw_value != 'none' and record.last_metrics_id.raw_value"
                    class="o_cx_monitor_kanban_detail w-100 mt-2 small"
                >
                    <hr class="mt-2 mb-2" />
                    <!-- CPU -->
                    <div class="d-flex align-items-center mb-1">
                        <span class="me-2" style="width: 35px;">
                            <i class="fa fa-microchip" title="CPU" />
                        </span>
                        <div class="progress flex-grow-1" style="height: 4px;">
                            <div
                                class="progress-bar"
                                t-att-class="record.cpu_usage_pct.raw_value > record.alert_cpu_pct.raw_value ? 'bg-danger' : (record.cpu_usage_pct.raw_value > record.alert_cpu_pct.raw_value * 0.8 ? 'bg-warning' : 'bg-success')"
                                t-attf-style="width: {{ record.cpu_usage_pct.raw_value }}%;"
                            />
                        </div>
                        <span class="ms-2">
                            <t
                            t-out="((record.cpu_usage_pct.raw_value / 100) * (record.cpu_cores.raw_value || 1)).toFixed(2)"
                        /> /
                            <t t-out="record.cpu_cores.raw_value || 0" /> Cores (<t
                            t-out="Math.round(record.cpu_usage_pct.raw_value || 0)"
                        />%)
                        </span>
                    </div>
                    <!-- RAM -->
                    <div class="d-flex align-items-center mb-1">
                        <span class="me-2" style="width: 35px;">
                            <i class="fa fa-tasks" title="RAM" />
                        </span>
                        <div class="progress flex-grow-1" style="height: 4px;">
                            <div
                                class="progress-bar"
                                t-att-class="record.ram_usage_pct.raw_value > record.alert_ram_pct.raw_value ? 'bg-danger' : (record.ram_usage_pct.raw_value > record.alert_ram_pct.raw_value * 0.8 ? 'bg-warning' : 'bg-success')"
                                t-attf-style="width: {{ record.ram_usage_pct.raw_value }}%;"
                            />
                        </div>
                        <span class="ms-2">
                            <t
                            t-out="(record.ram_used_mb.raw_value / 1024 || 0).toFixed(1)"
                        /> /
                            <t
                            t-out="(record.ram_total_mb.raw_value / 1024 || 0).toFixed(1)"
                        /> GB (<t
                            t-out="Math.round(record.ram_usage_pct.raw_value || 0)"
                        />%)
                        </span>
                    </div>
                    <!-- SSD -->
                    <div class="d-flex align-items-center mb-1">
                        <span class="me-2" style="width: 35px;">
                            <i class="fa fa-hdd-o" title="SSD" />
                        </span>
                        <div class="progress flex-grow-1" style="height: 4px;">
                            <div
                                class="progress-bar"
                                t-att-class="record.disk_usage_pct.raw_value > record.alert_disk_pct.raw_value ? 'bg-danger' : (record.disk_usage_pct.raw_value > record.alert_disk_pct.raw_value * 0.8 ? 'bg-warning' : 'bg-success')"
                                t-attf-style="width: {{ record.disk_usage_pct.raw_value }}%;"
                            />
                        </div>
                        <span class="ms-2">
                            <t
                            t-out="(record.disk_used_gb.raw_value || 0).toFixed(1)"
                        /> /
                            <t
                            t-out="(record.disk_total_gb.raw_value || 0).toFixed(1)"
                        /> GB (<t
                            t-out="Math.round(record.disk_usage_pct.raw_value || 0)"
                        />%)
                        </span>
                    </div>
                    <!-- Agent Status (at the bottom) -->
                    <div
                        class="mt-2 text-end w-100"
                        t-if="record.monitoring_mode.raw_value == 'push'"
                    >
                        <small class="text-muted">
                            Monitoring:
                            <i
                            t-attf-class="fa fa-circle ms-1 #{record.monitor_push_status.raw_value == 'active' ? 'text-success' : (record.monitor_push_status.raw_value == 'overdue' ? 'text-danger' : 'text-muted')}"
                            t-attf-title="Status: {{ record.monitor_push_status.value }}"
                        />
                            <t t-out="record.monitor_push_status.value" />
                        </small>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Server Form Inheritance -->
    <record id="cx_tower_server_view_form_inherit_monitor" model="ir.ui.view">
        <field name="name">cx.tower.server.view.form.inherit.monitor</field>
        <field name="model">cx.tower.server</field>
        <field name="inherit_id" ref="cetmix_tower_server.cx_tower_server_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside" />
            <xpath expr="//notebook" position="inside">
                <page name="monitoring" string="Monitoring">
                    <group
                        name="mon_last"
                        string="Visual Dashboard"
                        colspan="2"
                        invisible="monitoring_mode == 'none'"
                    >
                        <field
                            name="id"
                            widget="cx_tower_server_monitor_dashboard"
                            nolabel="1"
                            colspan="2"
                        />
                        <div class="mt-2 text-center" colspan="2">
                            <button
                                name="action_server_monitor_pull"
                                string="Refresh Now"
                                type="object"
                                class="btn-primary"
                                icon="fa-refresh"
                                invisible="monitoring_mode != 'pull'"
                            />
                            <span
                                class="ms-3 text-muted small"
                                invisible="monitoring_mode != 'pull'"
                            >Showing last 20 records</span>
                        </div>
                    </group>
                    <separator string="Monitoring Configuration" />
                    <group>
                        <group name="mon_config" string="Thresholds &amp; Agent">
                            <field name="monitoring_mode" />
                            <field
                                name="monitor_interval_pull"
                                invisible="monitoring_mode != 'pull'"
                            />
                            <field
                                name="monitor_interval_push"
                                invisible="monitoring_mode != 'push'"
                            />
                            <field name="alert_cpu_pct" />
                            <field name="alert_ram_pct" />
                            <field name="alert_disk_pct" />
                            <button
                                name="action_open_cron"
                                string="Manage Scheduled Action"
                                type="object"
                                class="btn-link"
                                icon="fa-clock-o"
                                invisible="monitoring_mode != 'pull'"
                            />
                        </group>
                        <group
                            name="mon_push"
                            string="Push Agent Management"
                            invisible="monitoring_mode != 'push'"
                        >
                            <field
                                name="monitor_token"
                                groups="cetmix_tower_server.group_manager"
                                widget="copy_clipboard"
                                readonly="1"
                            />
                            <field
                                name="is_push_agent_installed"
                                widget="boolean_toggle"
                            />
                            <field
                                name="monitor_push_status"
                                widget="badge"
                                decoration-success="monitor_push_status == 'active'"
                                decoration-danger="monitor_push_status == 'overdue'"
                                decoration-muted="monitor_push_status == 'none'"
                            />
                            <div class="mt-3" colspan="2">
                                <button
                                    name="action_install_push_agent"
                                    type="object"
                                    string="Deploy Agent via SSH"
                                    class="btn-primary w-100 mb-2"
                                    icon="fa-cloud-upload"
                                    invisible="is_push_agent_installed"
                                />
                                <button
                                    name="action_uninstall_push_agent"
                                    type="object"
                                    string="Remove Agent"
                                    class="btn-outline-danger w-100"
                                    icon="fa-trash"
                                    invisible="not is_push_agent_installed"
                                    confirm="Are you sure you want to remove the monitoring agent from the remote server?"
                                />
                                <div
                                    class="mt-2 text-muted small text-center"
                                    invisible="is_push_agent_installed"
                                >
                                    <i class="fa fa-info-circle me-1" />
                                    Requires SSH credentials to be configured.
                                </div>
                            </div>
                        </group>
                    </group>
                    <group>
                        <group name="mon_debug" string="Debug">
                            <button
                                name="action_monitor_debug"
                                string="Debug SSH Output"
                                type="object"
                                class="btn-secondary"
                                groups="base.group_no_one"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
