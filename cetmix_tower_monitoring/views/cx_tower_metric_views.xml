<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cx_tower_metric_view_list" model="ir.ui.view">
        <field name="name">cx.tower.metric.view.list</field>
        <field name="model">cx.tower.metric</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="reference" optional="show" />
                <field name="widget" />
                <field name="unit" />
                <field name="stale_after_minutes" optional="show" />
                <field name="auto_sync_minutes" optional="show" />
                <field name="command_id" optional="show" />
                <field name="plan_id" optional="show" />
                <field name="show_on_kanban" optional="hide" />
            </list>
        </field>
    </record>

    <record id="cx_tower_metric_view_form" model="ir.ui.view">
        <field name="name">cx.tower.metric.view.form</field>
        <field name="model">cx.tower.metric</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="e.g. Root Disk" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="reference" />
                            <field name="widget" />
                            <field name="unit" />
                            <field name="note" />
                        </group>
                        <group>
                            <field name="stale_after_minutes" />
                            <field name="auto_sync_minutes" />
                            <field name="show_on_kanban" />
                            <field name="command_id" invisible="plan_id" />
                            <field name="plan_id" invisible="command_id" />
                        </group>
                    </group>
                    <notebook>
                        <page name="thresholds" string="Thresholds">
                            <field name="threshold_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="condition" />
                                    <field
                                        name="value_float"
                                        invisible="condition == 'stale'"
                                        required="condition != 'stale'"
                                    />
                                    <field
                                        name="severity"
                                        invisible="condition == 'stale'"
                                        required="condition != 'stale'"
                                    />
                                    <field name="action" />
                                    <field
                                        name="command_id"
                                        invisible="action != 'command'"
                                        required="action == 'command'"
                                    />
                                    <field
                                        name="plan_id"
                                        invisible="action != 'plan'"
                                        required="action == 'plan'"
                                    />
                                </list>
                            </field>
                        </page>
                        <page name="yaml" string="YAML">
                            <div groups="!cetmix_tower_yaml.group_export">
                                <h3
                                >You must be a member of the "YAML/Export" group to export data as YAML.</h3>
                            </div>
                            <button
                                type="object"
                                groups="cetmix_tower_yaml.group_export"
                                class="oe_highlight"
                                name="action_open_yaml_export_wizard"
                                string="Export YAML"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cx_tower_metric_view_search" model="ir.ui.view">
        <field name="name">cx.tower.metric.view.search</field>
        <field name="model">cx.tower.metric</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="reference" />
                <field name="command_id" />
                <field name="plan_id" />
                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_widget"
                        string="Widget"
                        context="{'group_by': 'widget'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="cx_tower_metric_action" model="ir.actions.act_window">
        <field name="name">Metrics</field>
        <field name="res_model">cx.tower.metric</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="cx_tower_metric_export_yaml_action" model="ir.actions.act_window">
        <field name="name">Export YAML</field>
        <field name="res_model">cx.tower.yaml.export.wiz</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_cx_tower_metric" />
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('cetmix_tower_yaml.group_export'))]" />
    </record>
</odoo>
